# Server
PORT=3000
NODE_ENV=production

# PostgreSQL
DATABASE_URL="postgresql://forlms:changeme@localhost:5432/forlms?schema=public"

# JWT
JWT_SECRET="changeme-generate-a-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Active Directory / LDAP (ELR_LMS_009)
LDAP_URL="ldaps://dc.customs.sca.local:636"
LDAP_BIND_DN="CN=svc-forlms,OU=ServiceAccounts,DC=customs,DC=sca,DC=local"
LDAP_BIND_PASSWORD="changeme"
LDAP_BASE_DN="OU=Users,DC=customs,DC=sca,DC=local"
LDAP_USER_FILTER="(sAMAccountName={{username}})"
# Attribute mapping from AD -> User (ELR_LMS_009 attribute sync)
LDAP_ATTR_DISPLAY_NAME="displayName"
LDAP_ATTR_EMAIL="mail"
LDAP_ATTR_ORG_UNIT="department"
LDAP_ATTR_GROUPS="memberOf"

# SCORM content storage (ELR_LMS_003)
SCORM_STORAGE_PATH="/opt/forlms/storage/scorm-packages"
SCORM_MAX_PACKAGE_SIZE_MB=500
